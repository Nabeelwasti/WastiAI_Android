# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
XAI_API_KEY=MY_XAI_API_KEY
GEMINI_API_KEY=MY_GEMINI_API_KEY
OPENAI_API_KEY=MY_OPENAI_API_KEY
ANTHROPIC_API_KEY=MY_ANTHROPIC_API_KEY
DEEPSEEK_API_KEY=MY_DEEPSEEK_API_KEY
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
GROQ_API_KEY=MY_GROQ_API_KEY
ELEVENLABS_API_KEY=MY_ELEVENLABS_API_KEY
CANVA_CLIENT_ID=MY_CANVA_CLIENT_ID
CANVA_CLIENT_SECRET=MY_CANVA_CLIENT_SECRET
WASTI_GIT_PAT=MY_WASTI_GIT_PAT
WASTI_GIT_FINE_GRAINED_PAT=MY_WASTI_GIT_FINE_GRAINED_PAT
BREVO_API_KEY=MY_BREVO_API_KEY
BREVO_MCP_SERVER_API_KEY=MY_BREVO_MCP_SERVER_API_KEY
STRIPE_PUBLISHABLE_KEY=MY_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=MY_STRIPE_SECRET_KEY
STRIPE_SANDBOX_RESTRICTED_KEY_TOKEN=MY_STRIPE_SANDBOX_RESTRICTED_KEY_TOKEN
DRIVE_CLIENT_ID=MY_DRIVE_CLIENT_ID
DRIVE_CLIENT_SECRET=MY_DRIVE_CLIENT_SECRET
HUGGINGFACE_ACCESS_TOKEN=MY_HUGGINGFACE_ACCESS_TOKEN
UNSPLASH_APP_ID=MY_UNSPLASH_APP_ID
UNSPLASH_ACCESS_KEY=MY_UNSPLASH_ACCESS_KEY
UNSPLASH_SECRET_KEY=MY_UNSPLASH_SECRET_KEY
DISCORD_BOT_ID=MY_DISCORD_BOT_ID
DISCORD_BOT_KEY=MY_DISCORD_BOT_KEY
BYTEZ_API_KEY=MY_BYTEZ_API_KEY
CLOUDFLARE_API_KEY=MY_CLOUDFLARE_API_KEY
NOTION_CONNECTION_ID=MY_NOTION_CONNECTION_ID
HUBSPOT_CONNECTION_ID=MY_HUBSPOT_CONNECTION_ID
