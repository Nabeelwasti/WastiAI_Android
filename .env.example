# Wasti AI OS - Public & Client Build Configuration
# Note: In accordance with security architecture rules, private server secrets (API keys, PATs, tokens)
# must NEVER be committed to version control or packaged in public client builds.
# Users configure their private API keys securely at runtime via Settings > Credentials & API Keys (stored in EncryptedSharedPreferences).

# Public OAuth & Google Client Identifiers (Client-Safe)
PUBLIC_GOOGLE_WEB_CLIENT_ID=206322177649-fs2048huimberjvb4etaih1scn7ldh30.apps.googleusercontent.com
PUBLIC_GOOGLE_ANDROID_CLIENT_ID=206322177649-dmntaoaft0r4fj8qaurnpoapqmav4lrj.apps.googleusercontent.com

# Public API Base URL
PUBLIC_API_BASE_URL=https://api.wasti.ai/v1

