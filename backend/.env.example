# Example environment variables for Wasti AI OS backend orchestrator service
# Port and CORS configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Backend Authentication Secret (Required - fail closed if unset)
WASTI_BACKEND_AUTH_SECRET=your_secure_random_backend_token_here

# Outreach Email Protection (Required for /email/send)
OUTREACH_APPROVAL_TOKEN=your_secure_approval_token_here
BREVO_API_KEY=

# Stripe Webhook Security (Required for /stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LLM Providers (Optional / Fallback chain)
OPENAI_API_KEY=
BACKEND_GEMINI_KEY=
BACKEND_GROQ_VOICE=
LOCAL_LLM_URL=

# GitHub Integration (Required for /dev/patch)
BACKEND_GITHUB_PAT=
ALLOWED_GITHUB_REPOS=Nabeelwasti/WastiAI_Android
ALLOWED_PATCH_BRANCHES=main,master,develop

# Firebase Admin (Wakeword push forwarding)
FIREBASE_SA_BASE64=
# or FIREBASE_SA_PATH=/path/to/serviceAccountKey.json
